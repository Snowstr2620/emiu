# Mật khẩu quản trị cho tài khoản `admin` khi khởi tạo database lần đầu:
# - Chạy phát triển cục bộ (`npm run dev`): nếu bỏ trống, mật khẩu dev mặc định là `love2026`.
# - Chạy bản production (`npm run build && npm run start` hoặc deploy Vercel): BẮT BUỘC đặt mật khẩu mạnh KHÁC `love2026`.
# ADMIN_PASSWORD=hay-doi-mat-khau-manh-hon-2026

# Tuỳ chọn: Mã OTP 6 số mặc định cho tài khoản admin khi khởi tạo database lần đầu (mặc định: 140226)
# ADMIN_DEFAULT_OTP=140226

# Chuỗi bí mật để ký cookie phiên đăng nhập (BẮT BUỘC trong `npm run start` / Vercel; nên >= 32 ký tự ngẫu nhiên)
# Tạo nhanh trên terminal: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret-string-before-deploying

# Tuỳ chọn cho Server Riêng (VPS / Docker / PC tự host không dùng Supabase):
# Trỏ thư mục lưu local-db.json và ảnh/nhạc tải lên ra ngoài thư mục code để git pull / build không chạm tới dữ liệu.
# LOCAL_DATA_DIR=/var/lib/ny-memories/data
# LOCAL_UPLOAD_DIR=/var/lib/ny-memories/uploads

# Tuỳ chọn: Cấu hình Supabase Cloud (khi bỏ trống, web tự động chạy Chế độ Cục bộ với data/local-db.json)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=love-memories
